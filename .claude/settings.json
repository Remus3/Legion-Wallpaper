{
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/precommit_gate.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/precommit_gate.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__Windows-MCP__Scrape|mcp__computer-use__read_clipboard",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/text_first_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/pytest_guard.py\""
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/edit_lint_check.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/lw_facts.py\" --inbox-only",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/claimed_green_gate.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/lw_facts.py\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/caveman_default.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/lw_window_guard.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "pythonw \"$CLAUDE_PROJECT_DIR/tools/install_git_hooks.py\" --check",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
